#!/usr/bin/env bash
set -e

if [ -n "${DATABASE_HOST}" ]; then
  echo "waiting for postgres at ${DATABASE_HOST}:${DATABASE_PORT:-5432}..."
  until pg_isready -h "${DATABASE_HOST}" -p "${DATABASE_PORT:-5432}" -U "${DATABASE_USERNAME:-postgres}" >/dev/null 2>&1; do
    sleep 1
  done
fi

# Only the container with DB_PREPARE set touches the schema, so the others don't race on it.
if [ "${DB_PREPARE}" = "true" ]; then
  bundle exec rails db:create
  bundle exec rails db:migrate
fi

rm -f tmp/pids/server.pid

exec "$@"
